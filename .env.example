# انسخ هذا الملف باسم .env وحط مفتاحك الحقيقي. ملف .env ما يترفع على git.
# الإعداد الافتراضي: GPT-OSS 120B عبر Groq. أي مزوّد بواجهة OpenAI يشتغل بتغيير هذي القيم.
LLM_API_KEY=your_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE=https://api.groq.com/openai/v1

# مفاتيح احتياطية (اختياري): يجرّبها النظام بالترتيب لو الأول بلغ حده أو انقفل
